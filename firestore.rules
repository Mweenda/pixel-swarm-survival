rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.highScore is number && data.highScore >= 0 &&
        data.totalKills is number && data.totalKills >= 0 &&
        data.gamesPlayed is number && data.gamesPlayed >= 0 &&
        (!('bestTimeSeconds' in data) || (data.bestTimeSeconds is number && data.bestTimeSeconds >= 0)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 64)) &&
        (!('isGuest' in data) || (data.isGuest is bool));
    }

    function isValidLeaderboardEntry(data) {
      return isSignedIn() &&
        data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
        data.score is number && data.score >= 0 &&
        data.kills is number && data.kills >= 0 &&
        data.timeSurvived is number && data.timeSurvived >= 0;
    }

    // Isolated User Profile & Stats
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow scanning other users
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId;
      allow delete: if false;
    }

    // Public Leaderboard Scores
    match /leaderboard/{scoreId} {
      allow read: if true;
      allow create: if isValidId(scoreId) && isValidLeaderboardEntry(incoming());
      allow update, delete: if false; // Immutable once recorded
    }
  }
}
